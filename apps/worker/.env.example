# Admin role (BYPASSRLS): set-based sweeps across sites and global tables.
DATABASE_URL=postgres://pt2_admin:dev@localhost:5432/prayer_tools_v3_with_orgs_3
# App role (RLS enforced): every write of a site's data, inside withOrg.
APP_DATABASE_URL=postgres://pt2_app:dev@localhost:5432/prayer_tools_v3_with_orgs_3
DB_POOL_ADMIN=8
DB_POOL_APP=15

# Signs personal links (manage, unsubscribe, prayer content). Same value as the public server.
PT_SECRET=
PT_SITE_BASE_HOST=localhost:3480
PT_SITE_SCHEME=
PT_PLATFORM_HOST=
PT_ADMIN_URL=http://localhost:2480
PT_DONATE_URL=

# Email: mailgun | smtp | log
MAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAILGUN_API_KEY=
MAILGUN_HOST=
MAIL_DOMAIN_TRANSACTIONAL=mail.prayer.tools
MAIL_DOMAIN_MARKETING=news.prayer.tools

# Custom domains (Cloudflare for SaaS). Without a token the health check uses DNS.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_FALLBACK_ORIGIN=sites.prayer.tools

# Push for app users (end-of-campaign thank-you). Skipped when unset.
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# Monitoring. Uptime Kuma push URLs: one for the worker loop, one per scheduled job
# (KUMA_PUSH_DAILY_<JOB>, e.g. KUMA_PUSH_DAILY_CLOSE_CAMPAIGNS, _PERSONAL_COMPLETION,
# _CHECKINS, _UNVERIFIED_CLEANUP, _APP_INACTIVITY, _STATS_REFRESH, _DOMAINS, _RETENTION, _REAP_JOBS).
KUMA_PUSH_WORKER=
KUMA_PUSH_DAILY_CLOSE_CAMPAIGNS=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
LOG_LEVEL=info

# Tuning (defaults shown).
REMINDER_INTERVAL_MS=60000
JOB_INTERVAL_MS=5000
JOB_STALE_TIMEOUT_MINUTES=15
SHUTDOWN_TIMEOUT_MS=120000

## Replies to site emails go to the site inbox, <slug>@INBOX_DOMAIN (same values as the admin app)
INBOX_DOMAIN=inbox.prayer.tools
INBOX_SLUG_ADDRESSES=true
